{
  "name": "jack-script",
  "version": "0.1.0",
  "description": "Local-first screenwriting and stage-gated video production workstation.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jedisherpa/jack-script.git"
  },
  "bugs": {
    "url": "https://github.com/jedisherpa/jack-script/issues"
  },
  "homepage": "https://github.com/jedisherpa/jack-script#readme",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "desktop:web": "tsx scripts/run-desktop-web.ts dev",
    "desktop:web:build": "tsx scripts/run-desktop-web.ts build",
    "desktop:prepare-sidecar": "tsx scripts/prepare-tauri-sidecar.ts",
    "desktop:icon": "tsx scripts/generate-desktop-icon.ts && tauri icon src-tauri/icons/source-1024.png",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:signed": "tsx scripts/build-signed-desktop.ts",
    "desktop:package-dmg": "tsx scripts/package-desktop-dmg.ts",
    "desktop:notarize-dmg": "tsx scripts/notarize-desktop-dmg.ts",
    "desktop:verify-release": "tsx scripts/verify-desktop-release.ts",
    "desktop:verify-signed-release": "tsx scripts/verify-desktop-release.ts --require-developer-id --require-notarized",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "local:db:schema": "tsx scripts/print-local-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/pdfkit": "^0.17.6",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.38.0",
    "fast-xml-parser": "^5.8.0",
    "googleapis": "^144.0.0",
    "mammoth": "^1.12.0",
    "next": "^15.1.0",
    "pdfkit": "^0.19.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "puppeteer": "^25.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
