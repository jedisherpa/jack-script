# Jack Script — environment template
# Copy to .env.local for development.

# ── Local-first (recommended) ─────────────────────────────────────────────
# Ollama is the default LLM for script coverage, revision, and artifacts.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Local data directory (scripts, bibles, assets, SQLite DB)
# JACK_SCRIPT_DATA_DIR=/path/to/your/jack-script-data
# JACK_SCRIPT_DB_PATH=/path/to/jack-script.sqlite3
# JACK_SCRIPT_STORAGE_DIR=/path/to/storage

# Legacy Pillar Press paths still honored for migration:
# KINGS_PRESS_DATA_DIR=...
# KINGS_PRESS_DB_PATH=...

# ── Cloud LLM fallbacks (optional) ───────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── Media (optional — storyboards, table reads) ───────────────────────────
# HEDRA_API_KEY=
# ELEVENLABS_API_KEY=

# ── Google Drive export (optional) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Postgres mode (cloud deploy; omit for pure local-first) ───────────────
# DATABASE_URL=postgresql://...

# ── Basic auth gate (public deploys) ──────────────────────────────────────
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# ── Desktop / Tauri ───────────────────────────────────────────────────────
# TAURI_DEV=1