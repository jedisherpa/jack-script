# Jack Script — environment template
# Copy to .env.local for development.

# ── Local-first (recommended) ─────────────────────────────────────────────
# SQLite + disabled auth make the app runnable with no Postgres or Supabase.
KINGS_PRESS_LOCAL_FIRST=true
JACK_SCRIPT_LOCAL_FIRST=true
DATA_BACKEND=sqlite
AUTH_DISABLED=true

# Ollama is the default LLM for script coverage, revision, and artifacts.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2

# Local data directory (scripts, bibles, assets, SQLite DB)
# JACK_SCRIPT_DATA_DIR=/path/to/your/jack-script-data
# JACK_SCRIPT_DB_PATH=/path/to/jack-script.sqlite3
# JACK_SCRIPT_STORAGE_DIR=/path/to/storage

# Legacy Pillar Press paths still honored for migration:
# KINGS_PRESS_DATA_DIR=...
# KINGS_PRESS_DB_PATH=...

# ── Cloud LLM fallbacks (optional) ───────────────────────────────────────
# Default write provider (also used when review/revise are unset):

# Per-task overrides (write / review / revise):
# LLM_WRITE_PROVIDER=ollama
# LLM_WRITE_MODEL=llama3.2
# LLM_REVIEW_PROVIDER=anthropic
# LLM_REVIEW_MODEL=claude-sonnet-4-20250514
# LLM_REVISE_PROVIDER=openai
# LLM_REVISE_MODEL=gpt-4o

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# GROK_API_KEY=
# GROQ_API_KEY=
# MORPHEUS_API_KEY=
# MOR_API_KEY=
# KIMI_API_KEY=
# MOONSHOT_API_KEY=

# Named OpenAI-compatible provider defaults:
# Docker Model Runner: http://localhost:12434/engines/v1
# Groq: https://api.groq.com/openai/v1
# Morpheus: https://api.mor.org/api/v1
# Kimi / Moonshot: https://api.moonshot.ai/v1

# ── Media (optional — storyboards, table reads) ───────────────────────────
# HEDRA_API_KEY=
# ELEVENLABS_API_KEY=

# ── Google Drive export (optional) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Postgres mode (cloud deploy; omit for pure local-first) ───────────────
# DATABASE_URL=postgresql://...

# ── Basic auth gate (public deploys) ──────────────────────────────────────
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# ── Desktop / Tauri ───────────────────────────────────────────────────────
# TAURI_DEV=1
